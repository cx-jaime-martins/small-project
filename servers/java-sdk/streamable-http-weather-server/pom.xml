<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.modelcontextprotocol.sample</groupId>
    <artifactId>streamable-http-weather-server</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>MCP Java SDK - Streamable HTTP Weather Server</name>
    <description>MCP server exposing mock weather tools over the Streamable HTTP transport, hosted in embedded Tomcat.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mcp-bom.version>2.0.0</mcp-bom.version>
        <!-- Matches the jakarta.servlet-api / Tomcat versions the java-sdk itself builds and tests against -->
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <tomcat.version>11.0.2</tomcat.version>
        <main.class>io.modelcontextprotocol.sample.server.WeatherServer</main.class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Bundles mcp-core with the Jackson 3.x JSON binding -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <!--
            mcp-core depends on jakarta.servlet-api with scope "provided" since
            HttpServletStreamableServerTransportProvider is a plain HttpServlet meant to be
            hosted in a servlet container the application brings itself. This sample embeds
            Tomcat, so it supplies both the servlet API and the container.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>streamable-http-weather-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@0.6.2", "/home/user/projects"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.2.0", "postgresql://localhost/mydb"]
    },
    "python-runner": {
      "command": "uvx",
      "args": ["mcp-server-python@1.0.0"]
    },
    "docker-sandbox": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "mcp/sandbox:latest"]
    },
    "remote-assistant": {
      "url": "https://mcp.example.com/sse"
    }
  }
}
